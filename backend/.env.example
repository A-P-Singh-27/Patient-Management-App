# ==============================================================================
# CarePulse Backend Environment Configuration
# ==============================================================================

# Option 1: Neon Serverless PostgreSQL (Recommended for Deployment)
# Paste your Neon connection string below (ensure ?sslmode=require is included):
# DATABASE_URL=postgresql://neondb_owner:npg_YOUR_PASSWORD@ep-YOUR-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Local SQLite Persistent Storage (Default for local development)
DATABASE_URL=sqlite:///./patients.db

# Allowed CORS Origins (comma-separated, or * for public access)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,*

# Server Host & Port
HOST=0.0.0.0
PORT=8000
